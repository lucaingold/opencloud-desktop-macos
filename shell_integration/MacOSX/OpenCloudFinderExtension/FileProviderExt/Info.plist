<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <!-- Finder sidebar icon of the on-demand locations: OpenCloud logo as a template symbol (Assets.xcassets). -->
            <key>CFBundleSymbolName</key>
            <string>opencloud</string>
        </dict>
    </dict>
    <key>CFBundleDisplayName</key>
    <string>OpenCloud Desktop File Provider</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(OC_APPLICATION_REV_DOMAIN).$(PRODUCT_NAME:rfc1034identifier)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>XPC!</string>
    <key>CFBundleShortVersionString</key>
    <string>$(OC_APPLICATION_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(OC_APPLICATION_BUILD_VERSION)</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionFileProviderDocumentGroup</key>
        <string>$(TeamIdentifierPrefix)eu.opencloud.desktop</string>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.fileprovider-nonui</string>
        <key>NSExtensionPrincipalClass</key>
        <string>$(PRODUCT_MODULE_NAME).FileProviderExtension</string>
        <key>NSExtensionFileProviderActions</key>
        <array>
            <dict>
                <key>NSExtensionFileProviderActionIdentifier</key>
                <string>eu.opencloud.open-in-browser</string>
                <key>NSExtensionFileProviderActionName</key>
                <string>Open in browser</string>
                <key>NSExtensionFileProviderActionActivationRule</key>
                <string>fileproviderItems.@count == 1 AND SUBQUERY(fileproviderItems, $item, $item.userInfo.openCloudActions == YES).@count == 1</string>
            </dict>
            <dict>
                <key>NSExtensionFileProviderActionIdentifier</key>
                <string>eu.opencloud.share</string>
                <key>NSExtensionFileProviderActionName</key>
                <string>Share…</string>
                <key>NSExtensionFileProviderActionActivationRule</key>
                <string>fileproviderItems.@count == 1 AND SUBQUERY(fileproviderItems, $item, $item.userInfo.openCloudCanShare == YES).@count == 1</string>
            </dict>
            <dict>
                <key>NSExtensionFileProviderActionIdentifier</key>
                <string>eu.opencloud.versions</string>
                <key>NSExtensionFileProviderActionName</key>
                <string>Show file versions in browser</string>
                <key>NSExtensionFileProviderActionActivationRule</key>
                <string>fileproviderItems.@count == 1 AND SUBQUERY(fileproviderItems, $item, $item.userInfo.openCloudCanShowVersions == YES).@count == 1</string>
            </dict>
            <dict>
                <key>NSExtensionFileProviderActionIdentifier</key>
                <string>eu.opencloud.copy-private-link</string>
                <key>NSExtensionFileProviderActionName</key>
                <string>Copy private link</string>
                <key>NSExtensionFileProviderActionActivationRule</key>
                <string>fileproviderItems.@count == 1 AND SUBQUERY(fileproviderItems, $item, $item.userInfo.openCloudActions == YES).@count == 1</string>
            </dict>
        </array>
        <key>NSExtensionFileProviderSupportsEnumeration</key>
        <true/>
        <!-- Badge for files locked on the server, e.g. while open in the web office (FileProviderItem.decorations). -->
        <key>NSFileProviderDecorations</key>
        <array>
            <dict>
                <key>Identifier</key>
                <string>$(OC_APPLICATION_REV_DOMAIN).$(PRODUCT_NAME:rfc1034identifier).locked</string>
                <key>BadgeImageType</key>
                <string>com.apple.icon-decoration.badge.locked</string>
                <key>Category</key>
                <string>Badge</string>
                <key>Label</key>
                <string>Locked on the server</string>
            </dict>
        </array>
        <!-- Warnings before actions whose effect reaches beyond this Mac. -->
        <key>NSFileProviderUserInteractions</key>
        <array>
            <dict>
                <key>ActivationRule</key>
                <string>(action == "Trash" OR action == "Delete") AND sourceItem.isShared == YES AND sourceItem.isSharedByCurrentUser == NO</string>
                <key>Alert</key>
                <dict>
                    <key>LocalizedTitle</key>
                    <dict>
                        <key>NSStringFormat</key>
                        <string>Delete items from a share?</string>
                    </dict>
                    <key>LocalizedSubTitle</key>
                    <dict>
                        <key>NSStringFormat</key>
                        <string>They are deleted for the owner and everyone with access to the share, not only on this Mac.</string>
                    </dict>
                    <key>LocalizedRecoveryOptions</key>
                    <dict>
                        <key>Continue</key>
                        <string>Delete</string>
                    </dict>
                    <key>RecoveryOptions</key>
                    <dict>
                        <key>Destructive</key>
                        <true/>
                    </dict>
                </dict>
            </dict>
            <dict>
                <key>ActivationRule</key>
                <string>(action == "Trash" OR action == "Delete") AND sourceItem.isSharedByCurrentUser == YES</string>
                <key>Alert</key>
                <dict>
                    <key>LocalizedTitle</key>
                    <dict>
                        <key>NSStringFormat</key>
                        <string>Delete shared items?</string>
                    </dict>
                    <key>LocalizedSubTitle</key>
                    <dict>
                        <key>NSStringFormat</key>
                        <string>People you shared them with lose access.</string>
                    </dict>
                    <key>LocalizedRecoveryOptions</key>
                    <dict>
                        <key>Continue</key>
                        <string>Delete</string>
                    </dict>
                    <key>RecoveryOptions</key>
                    <dict>
                        <key>Destructive</key>
                        <true/>
                    </dict>
                </dict>
            </dict>
            <dict>
                <key>ActivationRule</key>
                <string>action == "MoveOut"</string>
                <key>SuppressionIdentifier</key>
                <string>moveOut</string>
                <!-- The SDK documents both spellings. -->
                <key>SupressionIdentifier</key>
                <string>moveOut</string>
                <key>Alert</key>
                <dict>
                    <key>LocalizedTitle</key>
                    <dict>
                        <key>NSStringFormat</key>
                        <string>Move items out of OpenCloud?</string>
                    </dict>
                    <key>LocalizedSubTitle</key>
                    <dict>
                        <key>NSStringFormat</key>
                        <string>They are removed from the server and are no longer available on your other devices or to people you shared them with. Copy them instead to keep them in OpenCloud.</string>
                    </dict>
                    <key>LocalizedRecoveryOptions</key>
                    <dict>
                        <key>Continue</key>
                        <string>Move</string>
                    </dict>
                    <key>RecoveryOptions</key>
                    <dict>
                        <key>Destructive</key>
                        <false/>
                    </dict>
                </dict>
            </dict>
        </array>
    </dict>
    <key>AppGroupIdentifier</key>
    <string>$(TeamIdentifierPrefix)eu.opencloud.desktop</string>
</dict>
</plist>
