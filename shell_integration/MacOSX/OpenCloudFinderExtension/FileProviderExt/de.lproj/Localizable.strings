"Share…" = "Teilen…";
"Show file versions in browser" = "Dateiversionen im Browser anzeigen";
"Copy private link" = "Privaten Link kopieren";

/* Sync problems reported to the desktop client's status menu (FileProviderSyncStatus.safeDescription). */
"Sign in to resume syncing." = "Melden Sie sich an, um die Synchronisation fortzusetzen.";
"The server is unreachable." = "Der Server ist nicht erreichbar.";
